# Environment variables for local development (without Docker)
# Copy this file to .env and adjust values as needed
# DO NOT commit .env to version control

PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nabaa_store
DB_USER=postgres
DB_PASSWORD=postgres123

# Or use DATABASE_URL for production (Railway provides this automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret — change this in production!
JWT_SECRET=change_me_to_a_random_long_secret_string

# Default admin password — change in production!
DEFAULT_ADMIN_PASSWORD=admin123

# Frontend URLs for CORS (set these on Railway)
FRONTEND_URL=https://your-customer-site.up.railway.app
ADMIN_URL=https://your-admin-dashboard.up.railway.app
